// Cloudflare Workers 설정. 배포: npx wrangler deploy
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "napolitan",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],

  // 게임 화면 파일. API·입장·이미지 경로는 워커가 먼저 받는다.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/enter", "/obj/*", "/healthz"]
  },

  // 방명록·플레이 기록·몸 상태
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "napolitan",
      "database_id": "8af0d646-b4b5-400c-9793-ddd6c0661e38",
      "migrations_dir": "migrations"
    }
  ],

  // 생성된 이미지
  "kv_namespaces": [
    { "binding": "IMAGES", "id": "c16c79825e2b4177966297c80fdedb77" }
  ],

  // 비밀이 아닌 설정. 비밀값(GEMINI_API_KEY·MARI_LINK_SECRET·SESSION_SECRET)은 wrangler secret put 으로.
  "vars": {
    "LLM_PROVIDER": "gemini",
    "IMAGE_PROVIDER": "gemini",
    "IMAGE_DAILY_LIMIT": "5"
  }
}
