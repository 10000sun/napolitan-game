# ── 판정을 맡길 AI ─────────────────────────────────────
# 방명록에 글이 적힐 때만 한 번 호출한다. 하루 수십 줄이면 무료 한도로 충분하다.
# 아래 셋 중 하나만 채우면 된다. LLM_PROVIDER 를 비워 두면 채워진 키를 보고 고른다.

LLM_PROVIDER=gemini

# ① Gemini — https://aistudio.google.com/apikey (무료 한도 넉넉함, 권장)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ② OpenAI 호환 — Groq / OpenRouter / Ollama 등이 전부 여기 붙는다
#    Groq       BASE_URL=https://api.groq.com/openai/v1        MODEL=llama-3.3-70b-versatile
#    OpenRouter BASE_URL=https://openrouter.ai/api/v1          MODEL=...:free
#    Ollama     BASE_URL=http://localhost:11434/v1             MODEL=llama3.1  (키 불필요)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile
# OPENAI_JSON_MODE=1

# ③ Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# ── 방명록 물체의 모습 ─────────────────────────────────
# 물체가 적힐 때 한 번만 만든다. 같은 물체는 다시 만들지 않는다.
# gemini: 위의 GEMINI_API_KEY 를 쓴다. 이미지 모델은 무료 한도가 없다 (장당 약 $0.034).
#         하루 IMAGE_DAILY_LIMIT 장을 넘으면 그날은 pollinations 로 넘어간다.
# pollinations: 익명 사용이 막혀 키가 필요하다 (pollinations.ai 에서 발급). 비우면 건너뛴다.
# none: 만들지 않고 이모지만.
IMAGE_PROVIDER=gemini
IMAGE_MODEL=gemini-3.1-flash-lite-image
IMAGE_DAILY_LIMIT=5
POLLINATIONS_API_KEY=

# ── 디스코드 ───────────────────────────────────────────
# 개발자 포털 > Application > OAuth2 에 {BASE_URL}/auth/callback 을 등록할 것
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# 이 서버원만 입장 가능. 디스코드에서 서버 우클릭 > 서버 ID 복사 (개발자 모드 필요)
DISCORD_GUILD_ID=

# ── 서버 ───────────────────────────────────────────────
BASE_URL=http://localhost:3000
SESSION_SECRET=change-me-to-something-random
PORT=3000
DB_PATH=./napolitan.db

# 1 로 두면 디스코드 로그인 없이 아무나 입장 (로컬 테스트용)
# 윈도우에서는 셸에 환경변수를 넣지 말고 여기를 1 로 바꾸는 게 편하다.
DEV_NO_AUTH=0
