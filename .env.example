# ── 필수 ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# 디스코드 개발자 포털 > Application > OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# 이 서버원만 입장 가능. 디스코드에서 서버 우클릭 > 서버 ID 복사 (개발자 모드 필요)
DISCORD_GUILD_ID=

# 배포 주소. 디스코드 OAuth2 Redirect 에 {BASE_URL}/auth/callback 을 등록할 것
BASE_URL=http://localhost:3000

# 세션 쿠키 서명용. 아무 긴 랜덤 문자열
SESSION_SECRET=change-me-to-something-random

# ── 선택 ──────────────────────────────────────────────
PORT=3000
DB_PATH=./napolitan.db
# 규칙 컴파일에 쓸 모델
ANTHROPIC_MODEL=claude-sonnet-5
# 1 로 두면 디스코드 로그인 없이 아무나 입장 (로컬 테스트용)
# 윈도우에서는 셸에 환경변수를 넣지 말고 여기를 1 로 바꾸는 게 편하다.
DEV_NO_AUTH=0
